void principal є: :э ¿:
    val int a Ͱ 10 »
    val int b Ͱ 3 »
    val bool activo Ͱ true »

    | if con else
    if є: ʃ:a:ʅ > ʃ:b:ʅ :э ¿:
        write є: 1 :э »
    :?
    else ¿:
        write є: 0 :э »
    :?

    | and
    if є: є:ʃ:a:ʅ == ʃ:10:ʅ:э λ є:ʃ:b:ʅ != ʃ:3:ʅ:э :э ¿:
        write є: 1 :э »
    :?
    else ¿:
        write є: 2 :э »
    :?

    | elif
    if є: ʃ:a:ʅ < ʃ:5:ʅ :э ¿:
        write є: 1 :э »
    :?
    elif є: ʃ:a:ʅ <= ʃ:10:ʅ :э ¿:
        write є: 2 :э »
    :?
    else ¿:
        write є: 3 :э »
    :?

    | not
    if Σ є: ʃ:a:ʅ < ʃ:b:ʅ :э ¿:
        write є: 4 :э »
    :?

    | or
    if є: є:ʃ:a:ʅ < ʃ:b:ʅ:э θ є: activo :э :э ¿:
        write є: 5 :э »
    :?

    | while
    val int c Ͱ 3 »
    while є: ʃ:c:ʅ > ʃ:0:ʅ :э ¿:
        write є: c :э »
        c Ͱ c - 1 »
    :?

    | for con break
    for є: val int i Ͱ 0 » ʃ:i:ʅ < ʃ:10:ʅ » i++ :э ¿:
        if є: ʃ:i:ʅ == ʃ:3:ʅ :э ¿:
            break »
        :?
        write є: i :э »
    :?
:?